# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/

# Virtual environments and deps
venv/
.venv/
env/
.env
!.env.example

# Local tooling
.claude/

# Runtime data, logs, and PIDs
logs/*.log
flask_session/
*.log
*.pid

# Databases and backups
*.db
*.db.backup-*
!*.db.example

# Downloads, generated media, and runtime binaries
core/downloads/*
!core/downloads/.gitkeep
core/ffmpeg/

# Cookies and credential files
core/youtube_cookies.txt

# Large data assets
static/js/datas/

# MSST (MVSep Mega) weights, downloaded on first use, and spike listening output
core/models/msst/
utils/testing/mvsep_mega_out/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
temp/
temp_files/

# Rotated logs, SQLite side files and local backups
logs/*.log.*
*.db-shm
*.db-wal
*.db.bak
*.bak
*.bak.*
